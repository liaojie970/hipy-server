ECHO_SQL=false
# selenium,hipy-sniffer,playwright 三选一
DEFAULT_SNIFFER=selenium
SNIFFER_URL=http://127.0.0.1:5708
API_DOMAIN=http://127.0.0.1:5707
AUTO_ADD_PERM_LABEL=true
PORT=5707
RELOAD=false
LOGIN_WITH_CAPTCHA=false
PROJECT_NAME=HiPy-嗨派
WEB_DOMAIN=https://hipy-ui.vercel.app
SECRET_KEY=DFGG45645674GHFGHFH

SQLALCHEMY_ENGINE=sqlite
# SQL_TABLE_PREFIX=t_
SQL_HOST=127.0.0.1
SQL_PORT=5432
SQL_USERNAME=hipy
SQL_PASSWORD=hipy
SQL_DATABASE=hipy

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# 密码; 也可用等价别名 REDIS_PWD (REDIS_PASSWORD 优先), 特殊字符无需转义
REDIS_PASSWORD=
REDIS_DB=3

# 缓存后端: redis(默认) | memory
#   memory = 进程内内存缓存, 适合手机/个人单进程部署, 无需启动 Redis
CACHE_BACKEND=redis
# Redis 连接失败时是否自动退化为内存缓存
CACHE_FALLBACK_TO_MEMORY=true
# 内存缓存最大键数量与过期清理间隔(秒)
MEMORY_CACHE_MAX_ENTRIES=10000
MEMORY_CACHE_SWEEP_INTERVAL=60
# 定时任务执行器进程池大小(默认 10)
#   手机/小内存设备建议设小(如 3)
SCHEDULER_POOL_SIZE=10

SMTP_HOST=smtp.qq.com
SMTP_USER=john_doe_1996@foxmail.com
SMTP_PASSWORD=ndkhgrgoimyvbhei
EMAIL_FROM_EMAIL=john_doe_1996@foxmail.com

IP_AGENTS=[""]
# 可选: 强制服务端使用的HTTP代理, 留空则跟随系统/环境变量.
# 当IDE/父进程注入了不可用的HTTP_PROXY导致请求卡死时, 在此填写真实代理, 如:
# SERVER_PROXY=http://127.0.0.1:7897
