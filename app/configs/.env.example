REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=3

# 缓存后端: redis(默认) | memory
#   memory = 进程内内存缓存, 适合手机/个人单进程部署, 无需启动 Redis
CACHE_BACKEND=redis
# Redis 连接失败时是否自动退化为内存缓存
CACHE_FALLBACK_TO_MEMORY=true
# 内存缓存最大键数量与过期清理间隔(秒)
MEMORY_CACHE_MAX_ENTRIES=10000
MEMORY_CACHE_SWEEP_INTERVAL=60

